# Optional: agar MongoDB local/Atlas hai toh yahan URI daalo.
# Khali chhodoge ya connect nahi hua toh app automatically in-memory MongoDB use karega (demo data ke saath).
MONGO_URI=mongodb://127.0.0.1:27017/skillswap
JWT_SECRET=change_this_secret_key
PORT=5000
CLIENT_URL=http://localhost:5173

# Google Sign-In (optional): Google Cloud Console -> Credentials -> OAuth Client ID (Web)
# Authorized JavaScript origins: http://localhost:5173 and http://localhost
GOOGLE_CLIENT_ID=

# AI SkillBot (optional): free key from https://aistudio.google.com/apikey
# Khali chhodoge toh SkillBot "offline mode" mein built-in roadmaps se jawab dega.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
